{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command",
           "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-dangerous.sh",
           "timeout": 10}
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {"type": "command",
           "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/autofix.sh"},
          {"type": "command",
           "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/selftest.sh"}
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {"type": "command",
           "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start-context.sh"}
        ]
      }
    ]
  }
}
